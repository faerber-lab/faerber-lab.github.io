@article{neidiger2024chemkb,
	title        = {Implementation of an Open Chemistry Knowledge Base with a Semantic Wiki},
	author       = {Charlotte Neidiger and Tarek Saier and Kai Kühn and Victor Larignon and Michael Färber and Claudia Bizzarri and Helena Šimek Tosino and Laura Holzhauer and Michael Erdmann and An Nguyen and Dean Harvey and Pierre Tremouilhac and Claudia Kramer and Daniel Hansch and Nicole Jung and Stefan Bräse},
	year         = 2024,
  	journal      = {J. Cheminformatics},
  	volume       = {17},
  	number       = {1},
  	pages        = {99},
	doi          = {10.26434/chemrxiv-2024-5dkhm},
	biburl       = {https://dblp.org/rec/journals/jcheminf/NeidigerSKLFBTHENHTKHSA25.bib},
	abstract     = {We present a concept for an open chemistry knowledge base that integrates research results into a collaboratively usable platform. To achieve this, we enhanced Semantic MediaWiki (SMW) with tools for capturing chemical structures in machine-readable formats and with data forms and models for standardized input and organization. These extensions enable effective comparison and contextual analysis of research within an expandable Wiki environment. The approach was demonstrated in the domain of CO2 reduction in homogeneous photocatalytic systems. Our work shows how subject-specific knowledge in chemistry can be collaboratively collected and managed by integrating cheminformatic tools into SMW, thereby providing a systematic, open alternative to commercial systems.},
	pdf         = {publications/ChemKB_Cheminformatics2025.pdf}
}

@misc{stein2024quantum,
	title        = {Incorporating Quantum Advantage in Quantum Circuit Generation through Genetic Programming},
	author       = {Christoph Stein and Michael Färber},
	year         = 2024,
	url          = {https://arxiv.org/abs/2501.09682},
	abstract     = {Designing efficient quantum circuits that leverage quantum advantage compared to classical computing has become increasingly critical. Genetic algorithms have shown potential in generating such circuits through artificial evolution. However, integrating quantum advantage into the fitness function of these algorithms remains unexplored. In this paper, we aim to enhance the efficiency of quantum circuit design by proposing two novel approaches for incorporating quantum advantage metrics into the fitness function of genetic algorithms.1 We evaluate our approaches based on the Bernstein-Vazirani Problem and the Unstructured Database Search Problem as test cases. The results demonstrate that our approaches not only improve the convergence speed of the genetic algorithm but also produce circuits comparable to expert-designed solutions. Our findings suggest that automated quantum circuit design using genetic algorithms that incorporate a measure of quantum advantage is a promising approach to accelerating the development of quantum algorithms.},
	keywords     = {quantum computing},
	pdf          = {publications/Quantum_Genetic_Programming_2024.pdf}
}

@incollection{faerber2021meaning,
	title        = {Theories of Meaning for the Internet of Things},
	author       = {Michael Färber and Yulia Svetashova and Andreas Harth},
	year         = 2021,
	booktitle    = {Language, Cognition, and Mind},
	doi          = {10.1007/978-3-030-69823-2_3},
	url          = {https://doi.org/10.1007/978-3-030-69823-2_3},
    abstract  = {In this chapter, we consider the theoretical foundations for representing knowledge in the Internet of Things context. Specifically, we consider (1) the model-theoretic semantics (i.e., extensional semantics), (2) the possible-world semantics (i.e., intensional semantics), (3) the situation semantics, and (4) the cognitive/distributional semantics. Given the peculiarities of the Internet of Things, we pay particular attention to (a) perception (i.e., how to establish a connection to the world), (b) intersubjectivity (i.e., how to align world representations), and (c) the dynamics of world knowledge (i.e., how to model events). We come to the conclusion that each of the semantic theories helps in modeling specific aspects, but does not sufficiently address all three aspects simultaneously.},
    pdf          = {publications/TheoriesOfMeaning_CoI2021.pdf},
    keywords    = {theory, philosophy}
}

