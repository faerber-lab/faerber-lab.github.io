@inproceedings{yuan2024whyheavy,
	title        = {Why Lift So Heavy? Slimming Large Language Models by Cutting Off the Layers},
	author       = {Shuzhou Yuan and Ercong Nie and Bolei Ma and Michael Färber},
	year         = 2024,
	booktitle    = {IJCNN},
	location     = {Rome, Italy},
	url          = {https://arxiv.org/abs/2402.11700},
	abstract = {Large Language Models (LLMs) exhibit exceptional capabilities across a wide range of natural language processing tasks. However, their immense size poses challenges for storage, training, and inference due to the billions of parameters introduced through deep layer stacking. While methods such as pruning and distillation can reduce model size, they frequently compromise performance. In this work, we systematically investigate the impact of reducing the number of layers in LLMs. Surprisingly, we find that even significantly shallower models maintain comparable or sometimes superior performance, particularly in prompt-based fine-tuning for text classification. In several cases, single-layer models outperform their fully layered counterparts. These results provide important insights for designing more efficient LLMs that mitigate size constraints while preserving performance, opening new avenues for resource-efficient large-scale language modeling.},
	pdf          = {publications/SlimLLM_IJCNN2024.pdf},
	keywords = {Large Language Models, Layer Reduction, Model Compression, Efficient NLP}
}

