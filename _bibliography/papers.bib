	abstract     = {This paper presents X-LiSA, an infrastructure for multilingual and cross-lingual semantic annotation, and XKnowSearch!, a system for entity-based semantic search. These tools utilize large knowledge bases to improve cross-lingual access to information and semantic search through disambiguation and translation of keyword queries.}
}
@misc{yuan2025gtex,
	title        = {Graph-Guided Textual Explanation Generation Framework},
	author       = {Shuzhou Yuan and Jingyi Sun and Ran Zhang and Michael Färber and Steffen Eger and Pepa Atanasova and Isabelle Augenstein},
	year         = 2025,
	url          = {https://arxiv.org/abs/2412.12318},
	abstract     = {We propose G-Tex, a framework for generating faithful natural language explanations guided by highlight explanations. The framework uses a graph neural network to align explanation generation with the model's reasoning process. Experiments show improved faithfulness and quality.}
}
@misc{qu2024greedycody,
	title        = {Greedy and CoDy: Counterfactual Explainers for Dynamic Graphs},
	author       = {Zhan Qu and Daniel Gomm and Michael Färber},
	year         = 2024,
	url          = {https://arxiv.org/abs/2403.16846},
	abstract     = {We introduce GreeDy and CoDy, two novel counterfactual explanation methods for temporal graph neural networks. CoDy uses Monte Carlo Tree Search to efficiently explore counterfactuals and shows superior performance over baseline methods in various datasets.}
}
@misc{yuan2025hallucinations,
	title        = {Hallucinations Can Improve Large Language Models in Drug Discovery},
	author       = {Shuzhou Yuan and Michael Färber},
	year         = 2025,
	url          = {https://arxiv.org/abs/2501.13824},
	abstract     = {This paper hypothesizes and demonstrates that hallucinations in LLMs can enhance their performance in drug discovery tasks. Experiments show hallucinated molecule descriptions improve classification accuracy, particularly with GPT-4o and Llama-3.}
}
@inproceedings{bogdoll2023influence,
	title        = {Impact, Attention, Influence: Early Assessment of Autonomous Driving Datasets},
	author       = {Daniel Bogdoll and Jonas Hendl and Felix Schreyer and Nishanth Gowda and Michael Färber and J. Marius Zöllner},
	year         = 2023,
	booktitle    = {ICCRE},
	url          = {https://arxiv.org/abs/2301.02200},
	abstract     = {This scientometric study proposes an Influence Score for early evaluation of autonomous driving datasets. It examines metadata and citation relations to predict dataset impact and guides dataset selection and design.}
}
@misc{barman2025lpm,
	title        = {Large Physics Models: Towards a Collaborative Approach with Large Language Models and Foundation Models},
	author       = {Kristian G. Barman and Sascha Caron and Emily Sullivan and Henk W. de Regt and Roberto Ruiz de Austri and Mieke Boon and Michael Färber and Stefan Fröse and Faegheh Hasibi and Andreas Ipp and Rukshak Kapoor and Gregor Kasieczka and Daniel Kostić and Michael Krämer and Tobias Golling and Luis G. Lopez and Jesus Marco and Sydney Otten and Pawel Pawlowski and Pietro Vischia and Erik Weber and Christoph Weniger},
	year         = 2025,
	booktitle    = {arXiv preprint arXiv:2501.05382},
	url          = {https://arxiv.org/abs/2501.05382},
	abstract     = {This paper outlines a roadmap for the development and evaluation of Large Physics Models (LPMs), tailored foundation models for physics. LPMs are proposed to integrate symbolic reasoning, physics-specific data processing, and interdisciplinary collaboration, enhancing research through development, evaluation, and philosophical reflection.}
}
@article{shao2024mloptical,
	title        = {Machine Learning in Short-Reach Optical Systems: A Comprehensive Survey},
	author       = {Chen Shao and Elias Giacoumidis and Syed Moktacim Billah and Shi Li and Jialei Li and Prashasti Sahu and André Richter and Michael Faerber and Tobias Kaefer},
	year         = 2024,
	booktitle    = {Photonics},
	url          = {https://doi.org/10.3390/photonics11070613},
	abstract     = {This survey reviews the application of machine learning in short-reach optical systems. It categorizes ML techniques into traditional, convolutional, transformer-based, and Fourier-based models, highlighting their potential in tasks like equalization, fault detection, and bandwidth prediction, with a focus on PONs and hardware efficiency.}
}
@misc{faerber2023diversity,
	title        = {Measuring Variety, Balance, and Disparity: An Analysis of Media Coverage of the 2021 German Federal Election},
	author       = {Michael Färber and Jannik Schwade and Adam Jatowt},
	year         = 2023,
	booktitle    = {arXiv preprint arXiv:2308.03531},
	url          = {https://arxiv.org/abs/2308.03531},
	abstract     = {This paper introduces a framework to assess news diversity based on variety, balance, and disparity. Using over 26,000 headlines from the 2021 German election, it applies topic modeling and proposes a novel metric for disparity, contributing to automated media diversity analysis.}
}
@misc{neidiger2024chemkb,
	title        = {Implementation of an Open Chemistry Knowledge Base with a Semantic Wiki},
	author       = {Charlotte Neidiger and Tarek Saier and Kai Kühn and Victor Larignon and Michael Färber and Claudia Bizzarri and Helena Šimek Tosino and Laura Holzhauer and Michael Erdmann and An Nguyen and Dean Harvey and Pierre Tremouilhac and Claudia Kramer and Daniel Hansch and Nicole Jung and Stefan Bräse},
	year         = 2024,
	booktitle    = {ChemRxiv Preprint},
	url          = {https://doi.org/10.26434/chemrxiv-2024-5dkhm},
	abstract     = {This work presents a Semantic MediaWiki-based platform to integrate chemical research data. The system enables collaborative input and structured representation of chemical knowledge, focusing on the domain of photocatalytic CO2 reduction and promoting open science practices.}
}
@misc{stein2024quantum,
	title        = {Incorporating Quantum Advantage in Quantum Circuit Generation through Genetic Programming},
	author       = {Christoph Stein and Michael Färber},
	year         = 2024,
	url          = {https://arxiv.org/abs/2501.09682},
	abstract     = {This paper proposes two novel fitness functions for genetic algorithms that explicitly incorporate quantum advantage. Evaluated on the Bernstein-Vazirani and Unstructured Database Search Problems, the methods improve convergence and produce circuits comparable to expert designs, advancing quantum circuit generation.}
}
@incollection{faerber2021meaning,
	title        = {Theories of Meaning for the Internet of Things},
	author       = {Michael Färber and Yulia Svetashova and Andreas Harth},
	year         = 2021,
	booktitle    = {Language, Cognition, and Mind},
	doi          = {10.1007/978-3-030-69823-2_3},
	url          = {https://doi.org/10.1007/978-3-030-69823-2_3},
	abstract     = {This chapter explores foundational issues in knowledge representation for the Internet of Things, combining insights from epistemology, semantic theories, and computer science. It highlights the limitations of traditional ontologies and proposes a more dynamic, grounded, and intersubjective approach.}
}
@inproceedings{faerber2023vocabexpander,
	title        = {Vocab-Expander: A System for Creating Domain-Specific Vocabularies Based on Word Embeddings},
	author       = {Michael Färber and Nicholas Popovic},
	year         = 2023,
	booktitle    = {RANLP},
	doi          = {10.48550/arXiv.2308.03519},
	url          = {https://arxiv.org/abs/2308.03519},
	abstract     = {VOCAB-EXPANDER is an online tool for building domain-specific vocabularies using word embeddings and ConceptNet. It supports tasks in innovation management, education, and interdisciplinary communication through term expansion and graph-based visualization.}
}
@inproceedings{yuan2024whyheavy,
	title        = {Why Lift So Heavy? Slimming Large Language Models by Cutting Off the Layers},
	author       = {Shuzhou Yuan and Ercong Nie and Bolei Ma and Michael Färber},
	year         = 2024,
	booktitle    = {IJCNN},
	url          = {https://arxiv.org/abs/2402.11700},
	abstract     = {This paper investigates reducing the size of large language models (LLMs) by layer pruning. Surprisingly, removing layers can preserve or even improve performance in classification tasks, reducing model size significantly.}
}
@inproceedings{shapiro2022sequence,
	title        = {Sequence Labeling for Citation Field Extraction from Cyrillic Script References},
	author       = {Igor Shapiro and Tarek Saier and Michael Färber},
	year         = 2022,
	booktitle    = {SDU@AAAI},
	url          = {https://www.researchgate.net/publication/366634946},
	abstract     = {This paper presents a dataset and multilingual BERT-based model for citation field extraction from Cyrillic script references. The model significantly outperforms existing tools and contributes to multilingual scholarly data processing.}
}
@inproceedings{faerber2023worldrep,
	title        = {Theories About World Representations for the Internet of Things},
	author       = {Michael Färber and Yulia Svetashova and Andreas Harth},
	year         = 2023,
	booktitle    = {CARLA},
	url          = {https://conceptresearch.github.io/CARLA/files/carla_2018/F%C3%A4rber.pdf},
	abstract     = {This paper discusses intersubjectivity, symbol grounding, and dynamic ontologies as foundational components for modeling knowledge in IoT settings. It connects philosophical theories with practical implications in computer science.}
}
