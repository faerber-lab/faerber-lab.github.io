{%- assign alumni = site.data.alumni | sort: "year" | reverse -%}
{%- assign lim = include.limit | default: 999 -%}
{%- assign boxed = include.boxed | default: "true" -%}

{%- if boxed == "true" -%}
<div class="my-3 border rounded" style="background: rgba(0,0,0,0.02);">
{%- endif -%}

<ul class="list-group list-group-flush mb-0">
{%- for a in alumni limit: lim -%}
  <li class="list-group-item bg-transparent py-3">
    <div>
      <strong>{{ a.name }}</strong>
      {%- if a.level_at_time and a.level_at_time != "" -%}
        <span class="text-muted"> ({{ a.level_at_time }}{% if a.year %}, {{ a.year }}{% endif %})</span>
      {%- elsif a.year -%}
        <span class="text-muted"> ({{ a.year }})</span>
      {%- endif -%}
    </div>

    {%- if a.now and a.now != "" -%}
      <div class="mt-1">
        <span class="text-muted">Now:</span>
        {%- if a.now_url and a.now_url != "" -%}
          <a href="{{ a.now_url }}">{{ a.now }}</a>
        {%- else -%}
          {{ a.now }}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if a.relation_to_group and a.relation_to_group != "" -%}
      <div class="small text-muted mt-1">{{ a.relation_to_group }}</div>
    {%- endif -%}

    {%- if a.highlight and a.highlight != "" -%}
      <div class="small text-muted mt-1">
        Highlight:
        {%- if a.highlight_url and a.highlight_url != "" -%}
          <a href="{{ a.highlight_url }}">{{ a.highlight }}</a>
        {%- else -%}
          {{ a.highlight }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </li>
{%- endfor -%}
</ul>

{%- if boxed == "true" -%}
</div>
{%- endif -%}
